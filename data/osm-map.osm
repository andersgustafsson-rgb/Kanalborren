 <node id="12986833418" visible="true" version="1" changeset="168628084" timestamp="2025-07-08T01:50:51Z" user="sebras" uid="216996" lat="55.5998896" lon="13.0031112">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Lugnet&#10;Kvarteret Katten 17, Storgata 8-16 och Lugna gata 42-46&#10;Byggherre MKB Fastighetes AB, byggår 1979&#10;Arkitekt Thorsten Roos Arkitektkontor&#10;Antal lägenheter 143"/>
  <tag k="inscription:1" v="Lugnet Kvarteret Katten 17, Storgata 8-16 och Lugna gata 42-46 Byggherre MKB Fastighetes AB, byggår 1979 Arkitekt Thorsten Roos Arkitektkontor Antal lägenheter 143"/>
  <tag k="inscription:2" v="MKB Fastighets AB:s bostadshus ligger i den äldsta delen av stadsdelen Lugnet, nära platsen för en herrgårdsliknande villa som ägaren, vice häradshövdingen Johan Groothe döpte till Lugnet i början av 1800-talet."/>
  <tag k="inscription:3" v="Några årtionden senare var han ruinerad och hans mark styckades upp i flera hundra små tomter som snabbt bebyggdes med småfolkshus och blev Malmös första och största renodlade arbetarstadsdel."/>
  <tag k="inscription:4" v="Under 1960- och 70-talen genomfördes, mot en stark folkvlija, en närmast total sanering av bebyggelsen och Lugnet fick sin nuvarande utformning med stora flerbostadshus kring gårdar och insprängda grönområden."/>
  <tag k="inscription:5" v="Bostadshusen i kvarteret Katten har en enkel arkitektur i linje med 1970-talets gestaltningsideal."/>
  <tag k="material" v="metal"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Lugnet"/>
  <tag k="note" v="The inscription has been added in multiple inscription tags, which is hopefully correct."/>
 </node>
